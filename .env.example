# ---- Telegram ----
# Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=
# Chat id that receives every order (owner or a staff group). Send /id to the bot to see yours.
TELEGRAM_CHAT_ID=
# Optional: secret Telegram sends with webhook calls. If empty it is derived from the bot token.
TELEGRAM_WEBHOOK_SECRET=

# ---- Staff & admin ----
# Staff join the bot with: /xodim <STAFF_PIN>
STAFF_PIN=
# Admin panel (/admin) login code and a long random string used to sign the login cookie
ADMIN_PIN=
ADMIN_SECRET=

# ---- Site ----
# Optional on Vercel (the production domain is detected). Set it when you attach your own domain.
NEXT_PUBLIC_SITE_URL=

# ---- Storage (Supabase) ----
# Project URL and the SECRET key (Project Settings → API Keys → "sb_secret_..."). Server-only — never the publishable key.
# Create the tables once with supabase/schema.sql. Without these the app uses a local SQLite file (.data/mikko.db) —
# fine locally, NOT on Vercel.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
