{
  "name": "mikko-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/setup-bot.mjs --deploy",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/telegram.test.mts",
    "bot:setup": "node --env-file=.env.local scripts/setup-bot.mjs",
    "bot": "tsc -p tsconfig.bot.json && node --env-file=.env.local --disable-warning=ExperimentalWarning scripts/bot-poll.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
